# Copy to .env and fill in. Never commit the real .env.

# Public address (DNS A record pointing at this server). No https:// and no trailing slash.
DOMAIN=register.example.com

# Database password. Choose a long random one: openssl rand -base64 24
POSTGRES_PASSWORD=

# Signing key for sign-in tokens, at least 32 bytes: openssl rand -base64 48
JWT_SECRET=

# Key that encrypts two-factor secrets at rest, exactly 32 random bytes, base64: openssl rand -base64 32
# KEEP A COPY OFF THIS SERVER. Without it every user's authenticator secret is unreadable and nobody can sign in.
ENCRYPTION_KEY=

# Outgoing email (password reset, vote and certificate notices). Production will not start without a mail host.
MAIL_FROM=no-reply@example.com
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Backups: where dumps go on this server, and how many days to keep them.
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=30
