# Copy to /opt/sijill/.env on the server and fill in. Never commit the real .env. chmod 600 .env

# Public address (Cloudflare DNS record, proxied). No https:// and no trailing slash.
DOMAIN=app.example.com

# Images the release workflows push to GitHub Container Registry. Lower case.
BACKEND_IMAGE_REPO=ghcr.io/arjunsambyal997/carta-new-backend
FRONTEND_IMAGE_REPO=ghcr.io/arjunsambyal997/carta-new-frontend

# Database password. Choose a long random one: openssl rand -hex 24
POSTGRES_PASSWORD=

# Signing key for sign-in tokens, at least 32 bytes: openssl rand -base64 48
JWT_SECRET=

# Key that encrypts two-factor secrets at rest, exactly 32 random bytes, base64: openssl rand -base64 32
# KEEP A COPY OFF THIS SERVER. Without it every user's authenticator secret is unreadable and nobody can sign in.
ENCRYPTION_KEY=

# Operator token for deploy/notice.sh (maintenance banner, feature flags): openssl rand -hex 32
SYSTEM_ADMIN_TOKEN=

# Outgoing email (password reset, vote and certificate notices). Production will not start without a mail host.
MAIL_FROM=no-reply@example.com
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Memory caps. Oracle Always Free Arm VM: 12 GB in total. Leave room for Postgres and the second colour during a deploy.
BACKEND_MEM_LIMIT=3g
FRONTEND_MEM_LIMIT=768m

# ---- Backups ----
# Local copies (encrypted) live here for BACKUP_LOCAL_RETENTION_DAYS; off-site copies are the real backup.
BACKUP_PATH=./backups
BACKUP_LOCAL_RETENTION_DAYS=7
# Daily run, hour in UTC. 22 = 02:00 Gulf time.
BACKUP_HOUR_UTC=22
# age public key (starts with age1...). Make the key pair on YOUR laptop, never on the server:
#   age-keygen -o sijill-backup.key     (prints the public key; keep the .key file in a password manager)
BACKUP_AGE_RECIPIENT=
# Off-site copy, S3 compatible. Cloudflare R2: provider Cloudflare, endpoint https://<account-id>.r2.cloudflarestorage.com
# Backblaze B2: provider Other, endpoint https://s3.<region>.backblazeb2.com
BACKUP_RCLONE_REMOTE=offsite:sijill-backups
BACKUP_S3_PROVIDER=Cloudflare
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Keep 30 daily and 12 monthly copies off-site.
BACKUP_REMOTE_DAILY_DAYS=30
BACKUP_REMOTE_MONTHLY_DAYS=365
# Heartbeat URL pinged after every good backup (Better Stack or healthchecks.io); it alerts you when a ping is missed.
BACKUP_PING_URL=
